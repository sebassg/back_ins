erDiagram
    usuario ||--|| credencial : "entra con"
    usuario ||--o{ sesion : "abre"
    sesion  ||--o{ refresh_token : "rota"
    usuario ||--o{ token_correo : "recibe"
    usuario ||--o{ intento_login : "origina"
    usuario ||--o{ auditoria : "ejecuta"
    usuario ||--o{ usuario : "provisiona"
    grupo      ||--o{ estudiante : "agrupa"
    usuario    ||--o{ grupo : "dirige"
    estudiante ||--o{ acudiente_estudiante : "tiene"
    usuario    ||--o{ acudiente_estudiante : "responde por"
    estudiante ||--o{ autorizacion_tratamiento_datos : "cuenta con"
    usuario    ||--o{ autorizacion_tratamiento_datos : "otorga"

    usuario {
        bigint id PK
        char uuid UK "identificador publico, claim sub del JWT"
        enum tipo_documento "CC, TI, RC, CE, PA, PEP"
        varchar numero_documento UK "usuario de inicio de sesion (HU07-E1)"
        varchar nombres
        varchar apellidos
        varchar correo UK "destino del enlace de activacion y recuperacion"
        varchar telefono "reservado para SMS"
        enum rol "ACUDIENTE, DOCENTE, ADMINISTRATIVO"
        enum estado "PENDIENTE_ACTIVACION, ACTIVO, INACTIVO"
        bigint creado_por FK "quien provisiono la cuenta"
        datetime creado_en
        datetime actualizado_en
    }

    credencial {
        bigint usuario_id PK, FK
        varchar hash_contrasena "scrypt; NULL hasta activar la cuenta"
        tinyint intentos_fallidos "HU07-E2: se bloquea al quinto"
        datetime bloqueado_hasta "HU07-E2: 15 minutos"
        datetime ultimo_ingreso_en
        datetime actualizado_en
    }

    sesion {
        char id PK "familia de refresh tokens"
        bigint usuario_id FK
        datetime creado_en
        datetime expira_en "techo absoluto: 90 dias"
        datetime ultimo_uso_en
        datetime revocada_en "HU12-E3"
        enum motivo_revocacion "CIERRE_SESION, USUARIO_DESACTIVADO, CAMBIO_CONTRASENA, REUSO_DETECTADO, ADMINISTRATIVA"
        json claims "fijados al iniciar sesion"
        varbinary ip
        varchar user_agent
        varchar dispositivo
    }

    refresh_token {
        char id PK "SHA-256 del token"
        char sesion_id FK
        datetime creado_en
        datetime expira_en "30 dias"
        datetime usado_en "un solo uso"
    }

    token_correo {
        char id PK "SHA-256 del token"
        enum proposito "password-reset, email-verification"
        bigint usuario_id FK
        varchar correo "unica direccion para la que sirve"
        char huella "invalida el enlace si cambia la contrasena"
        datetime creado_en
        datetime expira_en "HU07-E3: 30 minutos"
    }

    intento_login {
        bigint id PK
        bigint usuario_id FK "NULL si el documento no existe"
        varchar documento_ingresado
        boolean exitoso
        enum motivo_fallo
        varbinary ip
        varchar user_agent
        datetime creado_en
    }

    auditoria {
        bigint id PK
        bigint usuario_id FK
        varchar rol "congelado al momento del hecho"
        varchar accion
        varchar entidad
        varchar entidad_id
        json detalle
        varbinary ip
        datetime creado_en
    }

    grupo {
        bigint id PK
        varchar nombre UK "Transicion A, Jardin B"
        enum jornada "MANANA, TARDE, UNICA"
        time hora_salida "HU03 mide 2 horas contra ella; HU11 la cambia"
        bigint docente_id FK "docente titular del grupo"
        datetime creado_en
        datetime actualizado_en
    }

    estudiante {
        bigint id PK
        char uuid UK "identificador publico; contenido del QR (HU02)"
        enum tipo_documento "CC, TI, RC, CE, PA, PEP; por omision RC"
        varchar numero_documento UK "HU01-E2 rechaza el duplicado"
        varchar nombres
        varchar apellidos
        date fecha_nacimiento
        bigint grupo_id FK
        enum estado "ACTIVO, RETIRADO"
        bigint creado_por FK "quien registro la ficha (HU01-E1)"
        bigint actualizado_por FK "quien hizo el ultimo cambio (HU01-E3)"
        datetime creado_en
        datetime actualizado_en
    }

    acudiente_estudiante {
        bigint estudiante_id PK, FK
        bigint usuario_id PK, FK "la cuenta del acudiente"
        enum parentesco "MADRE, PADRE, ABUELO, TIO, HERMANO, TUTOR_LEGAL, OTRO"
        boolean titular "genera el pase (HU02) y autoriza terceros (HU03)"
        bigint titular_unico UK "columna generada: un solo titular por estudiante"
        enum estado "ACTIVO, INACTIVO; del vinculo, no de la cuenta"
        datetime creado_en
        datetime actualizado_en
    }

    autorizacion_tratamiento_datos {
        bigint id PK
        bigint estudiante_id FK
        bigint otorgado_por FK "el acudiente que autoriza"
        bigint registrado_por FK "el funcionario que dejo constancia"
        varchar version_aviso "version del aviso de privacidad aceptada"
        datetime otorgado_en
        datetime revocado_en "es revocable; la fila no se borra"
    }
