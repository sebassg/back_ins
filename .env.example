# ---------------------------------------------------------------------------
# Copie este archivo como .env y ajuste los valores. .env NO se versiona.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# Base de datos (MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=retiro_seguro
DB_USER=retiro_app
DB_PASSWORD=retiro_app
# Solo para db/install.sh y docker-compose (crear base y aplicar scripts)
DB_ROOT_USER=root
DB_ROOT_PASSWORD=root

# Sesión y tokens (HU07, HU12)
# Clave de firma del access token: mínimo 32 bytes. Genérela con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambie-esta-clave-por-una-aleatoria-de-32-bytes-o-mas
JWT_ISSUER=https://api.retiroseguro.local
JWT_AUDIENCE=app-retiro-seguro
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
REFRESH_TOKEN_ABSOLUTE_TTL=90d
SESSION_ABSOLUTE_TTL=7d
SESSION_IDLE_TTL=1d

# Reglas de HU07
MAX_INTENTOS_LOGIN=5
BLOQUEO_MINUTOS=15
# HU07-E3: el enlace de restablecimiento vence a los 30 minutos
TOKEN_RECUPERACION_TTL=30m
# Activación de la cuenta creada por la institución
TOKEN_ACTIVACION_TTL=72h
URL_APP=http://localhost:5173
URL_RESTABLECER_CONTRASENA=http://localhost:5173/restablecer-contrasena

# Reglas de HU01
# Versión del aviso de privacidad contra la que se registra la autorización de
# tratamiento de datos del menor (Ley 1581 de 2012). Cámbiela cuando cambie el
# aviso: las autorizaciones ya otorgadas conservan la versión que aceptaron.
VERSION_AVISO_PRIVACIDAD=2026-11

# Correo saliente (enlaces de activación y recuperación)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="Retiro Seguro <no-responder@iestebanochoa.edu.co>"
