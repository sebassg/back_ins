meta {
  name: Reenviar activación
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/reenviar-activacion
  body: json
  auth: none
}

body:json {
  {
    "numeroDocumento": "{{numeroDocumento}}"
  }
}

script:post-response {
  // Solo los correos enviados desde ahora cuentan para leer el enlace.
  bru.setVar("enlaceSolicitadoEn", Date.now());
  bru.setVar("tokenEnlace", "");
}

tests {
  test("responde 202", function () {
    expect(res.status).to.equal(202);
  });
}

docs {
  Envía el enlace de activación (72 h) solo si la cuenta está
  PENDIENTE_ACTIVACION. La respuesta es la misma en cualquier caso.
}
