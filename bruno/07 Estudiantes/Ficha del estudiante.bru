meta {
  name: Ficha del estudiante
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/estudiantes/{{uuidEstudiante}}
  body: none
  auth: inherit
}

script:pre-request {
  if (!bru.getVar("uuidEstudiante")) {
    bru.runner.skipRequest();
  }
}

tests {
  test("muestra el grupo, los acudientes y la autorización", function () {
    expect(res.status).to.equal(200);
    expect(res.body.acudientes).to.be.an("array");
    expect(res.body.grupo.horaSalida).to.match(/^\d{2}:\d{2}$/);
  });
}

docs {
  HU01-E3: la ficha con su grupo, sus acudientes (el titular primero), la
  autorización de tratamiento de datos y `actualizadoEn` /`actualizadoPor`,
  que son la fecha y el usuario del último cambio.

  Ejecute antes "Registrar estudiante", que guarda `uuidEstudiante`.
}
